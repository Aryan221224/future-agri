# Edge -> cloud bridge. Copy alongside mosquitto.conf on a field gateway.
connection edge-to-cloud
address cloud.example.com:8883
bridge_protocol_version mqttv50
# cleansession false is what makes the queue survive a disconnect.
cleansession false
topic farm/+/sensor/# out 1 "" ""
topic farm/+/observation/# out 1 "" ""
bridge_attempt_unsubscribe false
notifications true
restart_timeout 5 30
bridge_receive_maximum 40
bridge_session_expiry_interval 604800
# Certificates must outlive the longest plausible outage. A gateway offline for
# a month that reconnects with an expired cert can never drain its queue.
bridge_cafile /mosquitto/certs/ca.crt
bridge_certfile /mosquitto/certs/gateway.crt
bridge_keyfile /mosquitto/certs/gateway.key
